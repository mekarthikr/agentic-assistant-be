{
  "name": "agentic-assistant-be",
  "version": "1.0.0",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "rag:generate": "node scripts/generate-rag.mjs",
    "build": "npm run rag:generate && tsc && tsc-alias && node scripts/copy-knowledge.mjs && webpack --config webpack.config.cjs",
    "start": "node dist/server.js",
    "lint": "eslint src api",
    "lint:fix": "eslint src --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "tsx --test test/*.test.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://git.aspiresys.com/american-equity/agentic-assistant/backend.git"
  },
  "keywords": [],
  "author": "Aspire System",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.13",
    "@vercel/functions": "^3.7.6",
    "ai": "^7.0.37",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inversify": "^8.2.2",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  }
}
