{
  "name": "agentic-assistant-be",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist', '.vercel/output']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && tsc-alias && webpack --config webpack.config.cjs",
    "start": "node dist/server.js",
    "test": "npm run build && node --test --experimental-test-isolation=none test/enterprise-rag.test.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://git.aspiresys.com/american-equity/agentic-assistant/backend.git"
  },
  "keywords": [],
  "author": "Aspire System",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.13",
    "ai": "^7.0.37",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  }
}
