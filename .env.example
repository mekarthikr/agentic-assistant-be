PORT=5000
WS_PATH=/ws
LLAMA_API_KEY=your-meta-llama-api-key
LLAMA_MODEL=Llama-3.3-70B-Instruct
LLAMA_MODEL_CONTEXT_WINDOW=131072
# Optional override; defaults to https://api.llama.com/v1
# LLAMA_API_BASE_URL=https://api.llama.com/v1
ENTERPRISE_API_BASE_URL=https://mock-api-server-seven.vercel.app/api/v1
# When set, the browser sends this in the first WebSocket frame.
SOCKET_AUTH_TOKEN=replace-with-a-long-random-secret
