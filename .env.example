PORT=5000
WS_PATH=/ws
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_CONTEXT_WINDOW=131072
# Used for document and query embeddings through Vercel AI Gateway.
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
ENTERPRISE_API_BASE_URL=https://mock-api-server-seven.vercel.app/api/v1
# When set, the browser sends this in the first WebSocket frame.
SOCKET_AUTH_TOKEN=replace-with-a-long-random-secret
# Trusted application identity associated with the verified token above.
RAG_DEFAULT_USER_ID=local-development-user

# Chroma server and collection
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=documents
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database

# Cosine distance is used: lower is more relevant, and this is a maximum.
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_RELEVANCE_THRESHOLD=0.45
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_MAX_UPLOAD_BYTES=10485760
RAG_DATABASE_PATH=.data/documents.sqlite
